# Raw image datasets stay on the training machine.
Data/CNN/
Data/CNN-Data/
Data/CNN-MV/
Data/CNN-Combined/
Data/YOLO/**/images/
Data/YOLO/**/labels/
Data/YOLO/**/labels.cache
Data/YOLO/**/runs/

# ---- Training artefacts ----
Data/mistake/
Data/video/cnn_correct/
runs/
Data/runs/

# ---- Large transfer archives ----
*.tar
