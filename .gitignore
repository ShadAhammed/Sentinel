# Local secrets, if a machine has a .env. Never commit it.
.env

# Cursor IDE rules - machine-specific, not for public repo.
.cursor/
.cursorrules

# Python caches.
__pycache__/
*.pyc
.pytest_cache/

# Image datasets stay on the training machine. The repo keeps scripts, yaml, and tests.
Data/CNN/
Data/CNN-Data/
Data/CNN-MV/
Data/CNN-Combined/
Data/YOLO/**/images/
Data/YOLO/**/labels/
Data/YOLO/**/labels.cache
Data/YOLO/**/runs/

# Trained weights and engines stay on the training machine and the Jetson.
*.pt
*.engine
*.onnx
*.pkl

# Video and the photos used to make it stay on this machine.
*.mp4
Data/video/cnn_correct/*.jpg

# Dataset transfer archive. Too large for git.
*.tar

# Saved mistake review copies. The trainer can rebuild them.
Data/mistake/

# Local run folders.
runs/
Data/runs/

# Editor files can hold local paths.
*.code-workspace
